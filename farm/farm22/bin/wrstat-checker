#!/usr/bin/env bash

# Author: Michael Grace <mg38@sanger.ac.uk>
# Author: Ash Holland <ah37@sanger.ac.uk>

# Examine wrstat's output to see if anything looks wrong.

declare db_dir=/nfs/wrstat/db;
declare nfs_dir=/nfs/wrstat/nfs;
declare lustre_dir=/nfs/wrstat/lustre;
declare grace_days=2; # number of 24-hour periods to wait before producing a warning

# If any wrstat output files have been touched recently, everything is good, and we can exit immediately.
if [ -z "$(find "$db_dir" -mtime -$(( grace_days - 1 )) -print -quit 2>/dev/null)" ]; then
	echo "This script is located at: $(readlink -f "$0")";

	# Otherwise: we need to send an email!
	# Hopefully cron should email mercury (i.e. people in HGI) when we print things from this script.
	echo "Warning: No wrstat-ui output has been generated in $dir within the last $grace_days days.";
	echo;

	# If /nfs/wrstat is full, we should warn about that explicitly.
	echo "Disk usage information:";
	df -h "$dir";
	echo;
fi;

checkMountRun() {
	declare dir="$1";
	declare mount="$2";
	declare grace="$3";

	if [ -z "$(find "$dir" -maxdepth 1 -type d -name "*${mount//\//／}" -mtime -$(( grace - 1 )) -print)" -a -n "$(find "$dir" -maxdepth 1 -type d -name "*${mount//\//／}" -print)" ]; then
		echo "Warning: No wrstat output has been generated for mount $mount in $dir within the last $grace_days days.";
		echo;
	fi;
}

for mount in /lustre/*; do
	checkMountRun /nfs/wrstat/lustre "$mount" "$grace_days";
done;

while read mount; do
	checkMountRun /nfs/wrstat/nfs "$mount" 5;
done < /nfs/wrstat/nfs_shares.txt;

# TODO: include information about lost wr jobs (only accessible by sb10).
